{
  "_comment": "Request shapes published in the developer docs (/dev/invoices), the SDK READMEs/examples and openapi.json. Source of truth for the API side; the SDK repo (yo-facturo_sdk/contract/documented_examples.json) must carry the identical file (test_public_api_documented_examples.py compares them when the sibling checkout exists). Placeholders: <original_id> (an authorized comprobante), <customer_id> (a stored customer).",
  "invoice_minimal_final_price": {
    "issuer": "responsable_inscripto",
    "endpoint": "invoice",
    "body": {
      "punto_venta": 1, "concepto": 1,
      "tipo_documento": 99, "numero_documento": "0", "razon_social": "CONSUMIDOR FINAL",
      "items": [{"descripcion": "Servicio de consultoría", "cantidad": 1, "precio_unitario": 15000.0}]
    },
    "sdk": {"call": "invoices.create", "args": [], "kwargs": {
      "punto_venta": 1, "tipo_documento": 99, "numero_documento": "0", "razon_social": "CONSUMIDOR FINAL",
      "items": [{"descripcion": "Servicio de consultoría", "cantidad": 1, "precio_unitario": 15000.0}]
    }},
    "expect": {"tipo_comprobante": 6, "importe_total": "15000.00", "importe_neto_gravado": "12396.69", "importe_iva": "2603.31"}
  },
  "invoice_net_prices_opt_out": {
    "issuer": "responsable_inscripto",
    "endpoint": "invoice",
    "body": {
      "punto_venta": 1, "concepto": 1,
      "tipo_documento": 99, "numero_documento": "0", "razon_social": "CONSUMIDOR FINAL",
      "precios_con_iva": false,
      "items": [{"descripcion": "Producto demo", "cantidad": 1, "precio_unitario": 1000.0, "iva_id": 5}]
    },
    "expect": {"tipo_comprobante": 6, "importe_total": "1210.00", "importe_neto_gravado": "1000.00", "importe_iva": "210.00"}
  },
  "invoice_factura_c_monotributo": {
    "issuer": "monotributo",
    "endpoint": "invoice",
    "body": {
      "tipo_comprobante": 11, "punto_venta": 1, "concepto": 1,
      "tipo_documento": 99, "numero_documento": "0", "razon_social": "CONSUMIDOR FINAL",
      "condicion_iva_receptor_id": 5,
      "items": [{"descripcion": "Servicio de consultoría", "cantidad": 1, "precio_unitario": 15000.0}],
      "autorizar": true
    },
    "expect": {"tipo_comprobante": 11, "importe_total": "15000.00", "importe_neto_gravado": "15000.00", "importe_iva": "0.00"}
  },
  "invoice_factura_a_ri_receiver": {
    "issuer": "responsable_inscripto",
    "endpoint": "invoice",
    "body": {
      "tipo_comprobante": 1, "punto_venta": 1, "concepto": 1,
      "tipo_documento": 80, "numero_documento": "30710000014", "razon_social": "Comercial Andina S.A.",
      "condicion_iva_receptor_id": 1,
      "items": [{"descripcion": "Servicio de consultoría", "cantidad": 1, "precio_unitario": 121000.0, "iva_id": 5}],
      "autorizar": true
    },
    "expect": {"tipo_comprobante": 1, "importe_total": "121000.00", "importe_neto_gravado": "100000.00", "importe_iva": "21000.00"}
  },
  "invoice_line_discount": {
    "issuer": "responsable_inscripto",
    "endpoint": "invoice",
    "body": {
      "punto_venta": 1, "concepto": 1,
      "tipo_documento": 99, "numero_documento": "0", "razon_social": "CONSUMIDOR FINAL",
      "items": [{"descripcion": "Yerba Mate 1kg", "cantidad": 1, "precio_unitario": 1000.0, "bonificacion": 100.0, "iva_id": 5}]
    },
    "expect": {"tipo_comprobante": 6, "importe_total": "900.00"}
  },
  "invoice_bare_cuit_resolved_by_padron": {
    "issuer": "responsable_inscripto",
    "endpoint": "invoice",
    "body": {
      "punto_venta": 1, "concepto": 1,
      "tipo_documento": 80, "numero_documento": "27333444556", "razon_social": "Ferretería Sin Condición",
      "items": [{"descripcion": "Servicio de consultoría", "cantidad": 1, "precio_unitario": 121000.0, "iva_id": 5}]
    },
    "expect": {"tipo_comprobante": 1, "receptor_id": 1}
  },
  "invoice_receptor_condition_as_text": {
    "issuer": "responsable_inscripto",
    "endpoint": "invoice",
    "body": {
      "punto_venta": 1, "concepto": 1,
      "tipo_documento": 80, "numero_documento": "30699999993", "razon_social": "Club Social Exento",
      "receptor_condicion_iva": "exento",
      "items": [{"descripcion": "Cuota social", "cantidad": 1, "precio_unitario": 5000.0, "iva_id": 5}]
    },
    "expect": {"tipo_comprobante": 6, "receptor_id": 4}
  },
  "invoice_to_stored_customer": {
    "issuer": "responsable_inscripto",
    "endpoint": "invoice_customer",
    "body": {
      "customer_id": "<customer_id>", "punto_venta": 1, "concepto": 1,
      "items": [{"descripcion": "Servicio de consultoría", "cantidad": 1, "precio_unitario": 15000.0}]
    },
    "sdk": {"call": "invoices.create_for_customer", "args": ["<customer_id>"], "kwargs": {
      "punto_venta": 1,
      "items": [{"descripcion": "Servicio de consultoría", "cantidad": 1, "precio_unitario": 15000.0}]
    }},
    "expect": {"tipo_comprobante": 1, "receptor_id": 1}
  },
  "debit_note_items_net_with_total": {
    "issuer": "responsable_inscripto",
    "endpoint": "debit_note",
    "body": {
      "comprobante_asociado_id": "<original_id>",
      "items": [{"descripcion": "Interés por mora", "cantidad": 1, "precio_unitario": 100.0, "iva_id": 5}],
      "importe_total": 121.0,
      "motivo": "Interés por mora"
    },
    "sdk": {"call": "invoices.debit_note", "args": ["<original_id>", [{"descripcion": "Interés por mora", "cantidad": 1, "precio_unitario": 100.0, "iva_id": 5}]], "kwargs": {
      "importe_total": 121.0, "motivo": "Interés por mora"
    }},
    "expect": {"tipo_comprobante": 7, "importe_total": "121.00", "importe_neto_gravado": "100.00", "importe_iva": "21.00"}
  },
  "credit_note_total": {
    "issuer": "responsable_inscripto",
    "endpoint": "credit_note",
    "body": {"comprobante_asociado_id": "<original_id>", "motivo": "Anulación de la operación"},
    "sdk": {"call": "invoices.credit_note", "args": ["<original_id>"], "kwargs": {"motivo": "Anulación de la operación"}},
    "expect": {"importe_total": "2420.00"}
  },
  "credit_note_by_lines": {
    "issuer": "responsable_inscripto",
    "endpoint": "credit_note",
    "body": {"comprobante_asociado_id": "<original_id>", "lineas": [{"linea": 1, "cantidad": 1}], "motivo": "Devolución parcial de mercadería"},
    "sdk": {"call": "invoices.credit_note", "args": ["<original_id>"], "kwargs": {
      "lineas": [{"linea": 1, "cantidad": 1}], "motivo": "Devolución parcial de mercadería"
    }},
    "expect": {"importe_total": "605.00"}
  },
  "credit_note_by_amount": {
    "issuer": "responsable_inscripto",
    "endpoint": "credit_note",
    "body": {"comprobante_asociado_id": "<original_id>", "importe_a_acreditar": 605.0, "motivo": "Bonificación posterior a la venta"},
    "sdk": {"call": "invoices.credit_note", "args": ["<original_id>"], "kwargs": {
      "importe_a_acreditar": 605.0, "motivo": "Bonificación posterior a la venta"
    }},
    "expect": {"importe_total": "605.00"}
  },
  "credit_note_by_percentage": {
    "issuer": "responsable_inscripto",
    "endpoint": "credit_note",
    "body": {"comprobante_asociado_id": "<original_id>", "porcentaje_aplicar": 50, "motivo": "Devolución parcial de mercadería"},
    "sdk": {"call": "invoices.credit_note", "args": ["<original_id>"], "kwargs": {
      "porcentaje_aplicar": 50, "motivo": "Devolución parcial de mercadería"
    }},
    "expect": {"importe_total": "1210.00"}
  },
  "_partner_examples": {
    "_comment": "Documentation-only (no runner posts these: partner endpoints need a registered partner account). Keys mirror openapi.json schemas Partner* / InvoiceCreateRequest.taxpayer_id; checked by a schema-keys script when P12c was written. Underscore prefix keeps both contract tests skipping this entry.",
    "register_taxpayer": {
      "request": "POST /partner/taxpayers/",
      "body": {
        "tax_id": "20111111112",
        "tax_condition": "monotributo",
        "punto_venta": "2",
        "business_name": "Cliente SA"
      },
      "sdk": {
        "call": "partner.create_taxpayer",
        "args": [
          "20111111112"
        ],
        "kwargs": {
          "tax_condition": "monotributo",
          "punto_venta": "2",
          "business_name": "Cliente SA"
        }
      },
      "response": {
        "id": "6650f2c1a1b2c3d4e5f60718",
        "tax_id": "20111111112",
        "business_name": "Cliente SA",
        "tax_condition": "monotributo",
        "punto_venta": "2",
        "default_invoice_type": "C",
        "delegation_verified": false,
        "delegation_verified_at": null,
        "afip_environment": "production"
      }
    },
    "list_taxpayers": {
      "request": "GET /partner/taxpayers/?limit=100&q=cliente",
      "sdk": {
        "call": "partner.list_taxpayers",
        "args": [],
        "kwargs": {
          "limit": 100,
          "q": "cliente"
        }
      },
      "response": {
        "items": [
          {
            "id": "6650f2c1a1b2c3d4e5f60718",
            "tax_id": "20111111112",
            "business_name": "Cliente SA",
            "tax_condition": "monotributo",
            "punto_venta": "2",
            "default_invoice_type": "C",
            "delegation_verified": true,
            "afip_environment": "production"
          }
        ],
        "count": 1,
        "next_cursor": null
      }
    },
    "verify_delegation": {
      "request": "POST /partner/taxpayers/6650f2c1a1b2c3d4e5f60718/verify-delegation/",
      "sdk": {
        "call": "partner.verify_delegation",
        "args": [
          "6650f2c1a1b2c3d4e5f60718"
        ],
        "kwargs": {}
      },
      "response": {
        "taxpayer_id": "6650f2c1a1b2c3d4e5f60718",
        "cuit": "20111111112",
        "delegation_verified": false,
        "platform_cuit": "<YoFacturo CUIT>",
        "afip_error": "Falta delegar el servicio WSFE"
      }
    },
    "usage": {
      "request": "GET /partner/usage/",
      "sdk": {
        "call": "partner.usage",
        "args": [],
        "kwargs": {}
      },
      "response": {
        "period_start": "2026-10-01T00:00:00-03:00",
        "period_end": "2026-11-01T00:00:00-03:00",
        "active_cuits_count": 12,
        "active_cuits": [
          "20111111112"
        ],
        "active_cuits_overflow": 11,
        "extra_cuits": 2,
        "estimate_ars": "150000",
        "included_cuits": 10,
        "base_price_ars": "100000",
        "extra_cuit_price_ars": "25000"
      }
    },
    "invoice_with_taxpayer_id": {
      "request": "POST /bill/receipts/invoice/",
      "body": {
        "taxpayer_id": "6650f2c1a1b2c3d4e5f60718",
        "concepto": 1,
        "tipo_documento": 99,
        "numero_documento": "0",
        "razon_social": "CONSUMIDOR FINAL",
        "items": [
          {
            "descripcion": "Servicio de consultoría",
            "cantidad": 1,
            "precio_unitario": 15000.0
          }
        ]
      },
      "sdk": {
        "call": "invoices.create",
        "args": [],
        "kwargs": {
          "taxpayer_id": "6650f2c1a1b2c3d4e5f60718",
          "tipo_documento": 99,
          "numero_documento": "0",
          "razon_social": "CONSUMIDOR FINAL",
          "items": [
            {
              "descripcion": "Servicio de consultoría",
              "cantidad": 1,
              "precio_unitario": 15000.0
            }
          ]
        }
      }
    }
  }
